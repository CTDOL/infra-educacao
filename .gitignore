# Arquivos de configuração reais com senhas
# (ancorado na raiz: o config.php de temas, ex. theme/ctdol/config.php, DEVE ser versionado)
/config.php
*.env
*.env.*

# Backups e Dumps SQL
*.sql
*.sql.gz
/backups/

# Logs e arquivos temporários
*.log
/logs/
*.tmp

# Arquivos de sistema operacional
.DS_Store
Thumbs.db

# Chaves privadas e certificados
*.pem
*.key
*.id
id_*
